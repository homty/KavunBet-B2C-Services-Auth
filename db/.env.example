POSTGRES_DB=betwin_dev
POSTGRES_ADMIN_USER=betwin
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-admin-password
POSTGRES_PORT=5433

# Prefer long URL-safe values containing only letters, digits, underscores,
# and hyphens so Compose and DATABASE_URL do not reinterpret the passwords.
AUTH_DB_PASSWORD=replace-with-a-strong-auth-role-password
USER_DB_PASSWORD=replace-with-a-strong-user-role-password
WALLET_DB_PASSWORD=replace-with-a-strong-wallet-role-password

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://betwin:replace-with-a-strong-database-password@localhost:5433/betwin_dev?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations
